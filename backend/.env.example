# ToonChat Backend Environment Configuration Example
# Copy to .env for local development

PROJECT_NAME="ToonChat API"
ENVIRONMENT=development
API_V1_STR=/api/v1

# -----------------------------------------------------------------------------
# Database Selection: 'local' (default) or 'supabase'
# -----------------------------------------------------------------------------
DB_TARGET=local

# Local development database (Docker Compose or local PostgreSQL service)
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/toonchat_dev

# Supabase PostgreSQL Connection String (Private - never commit real values)
# Recommended Option: Supavisor Session Pooler (IPv4 compatible, Port 5432)
# Format: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
# Alternative: Direct Connection (requires IPv6 routing or IPv4 add-on):
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require
SUPABASE_DATABASE_URL=

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Auth Configuration (Production Identity Provider)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_ALGORITHM=HS256

# Capacities
GROUP_MAX_MEMBERS=250
STORY_TTL_HOURS=24
